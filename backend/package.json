    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1"
